# LiveKit connection (required for cli.run_app / JobContext.connect)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT / LLM / TTS providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Azure Speech (for testing en-NG neural voices — see test_azure_voice.py)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Firebase (call recordings + call records). service_account.json must exist
# in the project root — see README/chat history for how it was provisioned.
# These two are optional; defaults already match the fssspark project.
FIREBASE_SERVICE_ACCOUNT_PATH=service_account.json
FIREBASE_STORAGE_BUCKET=fssspark.firebasestorage.app
